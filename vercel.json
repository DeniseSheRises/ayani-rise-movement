{
  "rewrites": [
    {
      "source": "/return-to-her",
      "destination": "https://return-to-her-1.vercel.app/"
    },
    {
      "source": "/return-to-her/:path*",
      "destination": "https://return-to-her-1.vercel.app/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://return-to-her-1.vercel.app/_next/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://return-to-her-1.vercel.app/images/:path*"
    }
  ]
}
